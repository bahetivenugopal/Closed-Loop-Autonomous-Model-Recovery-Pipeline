# ============================================================
# Environment & Configuration Template (.env.example)
# Placeholders ONLY - Do NOT place real production secrets here.
# ============================================================

# Application & Security
SECRET_KEY=your-production-secret-key-here

# MLOps Database Configuration (Operational Storage)
POSTGRES_HOST=postgres-mlops
POSTGRES_PORT=5432
MLOPS_DB_NAME=mlops
POSTGRES_USER=your_mlops_db_user
POSTGRES_PASSWORD=your_mlops_db_password

# Airflow Database Configuration (Metadata Storage)
AIRFLOW_DB_HOST=postgres
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=your_airflow_db_user
AIRFLOW_DB_PASSWORD=your_airflow_db_password

# Airflow Webserver & Security
AIRFLOW_USERNAME=your_airflow_username
AIRFLOW_PASSWORD=your_airflow_password
AIRFLOW_EMAIL=your_admin_email@example.com
AIRFLOW_WEBSERVER_HOST_PORT=8081
AIRFLOW_SECRET_KEY=your-airflow-secret-key
AIRFLOW_FERNET_KEY=your-airflow-fernet-key

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_USERNAME=your_mlflow_username
MLFLOW_PASSWORD=your_mlflow_password

# PgAdmin Management UI
PGADMIN_EMAIL=your_pgadmin_email@example.com
PGADMIN_PASSWORD=your_pgadmin_password

# Monitoring Scheduler Context
MONITORING_INTERVAL=300
MONITORING_LOOKBACK=24
